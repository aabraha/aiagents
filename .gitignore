# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment and secrets
.env
.env.*
!.env.example

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# OS/editor artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/

# Gradio local artifacts
.gradio/

# Local resource files (often personal/sensitive)
careeragent/resources/*.pdf
careeragent/resources/*.txt
!careeragent/resources/.gitkeep
